{
  "name": "velox-automation",
  "version": "2.1.1",
  "description": "Browser automation at terminal velocity. Zero dependencies: any installed Chrome/Chromium/Edge/Brave over CDP, or no browser at all for static pages. Playwright-compatible API, proxies (http/socks5, rotating pools), plugins, batching, retries and reconnects.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/velox.d.ts",
  "bin": {
    "vlx": "./bin/vlx.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./types/velox.d.ts"
    },
    "./lite": "./src/lite/engine.js",
    "./cdp": "./src/cdp/browser.js"
  },
  "icon": "assets/icon.png",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "bin",
    "types",
    "assets/icon.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.js",
    "bench": "node test/bench.js",
    "site": "node test/site/serve.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "automation",
    "browser-automation",
    "scraping",
    "web-scraping",
    "cdp",
    "chrome-devtools-protocol",
    "headless",
    "headless-chrome",
    "playwright",
    "playwright-alternative",
    "puppeteer",
    "puppeteer-alternative",
    "selenium",
    "zero-dependencies",
    "no-dependencies",
    "fast",
    "locators",
    "stealth",
    "screenshot",
    "pdf",
    "har",
    "tracing",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loak7993-code/velox.git"
  },
  "bugs": {
    "url": "https://github.com/loak7993-code/velox/issues"
  },
  "homepage": "https://github.com/loak7993-code/velox#readme",
  "author": "loak7993",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
